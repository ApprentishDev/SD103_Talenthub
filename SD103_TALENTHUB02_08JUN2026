                        cout << "\n[Domestic Database] Student found:\n";
                        foundDomestic->getInfo();
                    }
                    else {
                        cout << "\n[Domestic Database] Student not found.\n";
                    }

                    // Print International results
                    if (foundInternational != nullptr) {
                        cout << "\n[International Database] Student found:\n";
                        foundInternational->getInfo();
                    }
                    else {
                        cout << "\n[International Database] Student not found.\n";
                    }

                    break;
                }

                case 2: { // VIEW DOMESTIC STUDENTS - working
                    cout << "[2] Selected\n";
                    cout << "\nDomestic students Enrolled:" << endl;
                    for (int i = 0; i < dmtcStudents.size(); i++) {
                        dmtcStudents[i].getInfo();
                    }
                    cout << "\n--------------------" << endl;
                    cout << "Press any key to go back " << endl;
                    char backValue;
                    cin >> backValue;

                    break;
                }

                case 3: { // VIEW INTERNATIONAL STUDENTS - working
                    cout << "[3] Selected\n";
                    cout << "\nInternational students Enrolled:" << endl;
                    for (int i = 0; i < intlStudents.size(); i++) {
                        intlStudents[i].getInfo();
                    }
                    cout << "\n--------------------" << endl;
                    cout << "Press any key to go back " << endl;
                    char backValue;
                    cin >> backValue;

                    break;
                }

                case 4: { //VIEW ALL STUDENTS - working
                    cout << "[4] Selected\n";
                    cout << "\n-------------------------------|" << endl;
                    cout << "\nDomestic students Enrolled:" << endl;
                    for (int i = 0; i < dmtcStudents.size(); i++) {
                        dmtcStudents[i].getInfo();
                    }

                    cout << "\n--------------------" << endl;
                    cout << "\n-------------------------------|" << endl;
                    cout << "\nInternational students enrolled:" << endl;

                    for (int i = 0; i < intlStudents.size(); i++) {
                        intlStudents[i].getInfo();
                    }
                    cout << "\n--------------------" << endl;

                    break;
                }

                case 5: { //REMOVE A STUDENT FROM A COURSE
                    cout << "[5] Selected - Remove Student From Course\n";
                    cout << "Enter the ID number of the student: ";
                    int targetId;
                    cin >> targetId;

                    cin.clear(); //Purge / clear input
                    cin.ignore(numeric_limits<streamsize>::max(), '\n');

                    Student* foundStudent = nullptr;
                    bool isDomestic = true;

                    // 1. Search within the Domestic Students vector
                    auto itDmtc = find_if(dmtcStudents.begin(), dmtcStudents.end(),
                        [targetId](const Student& s) { return s.getidNumber() == targetId; });

                    if (itDmtc != dmtcStudents.end()) {
                        foundStudent = &(*itDmtc);
                        isDomestic = true;
                    }
                    else {
                        // 2. Search within the International Students vector if not found yet
                        auto itIntl = find_if(intlStudents.begin(), intlStudents.end(),
                            [targetId](const Student& s) { return s.getidNumber() == targetId; });

                        if (itIntl != intlStudents.end()) {
                            foundStudent = &(*itIntl);
                            isDomestic = false;
                        }
                    }

                    // 3. Process the course removal if the student exists
                    if (foundStudent != nullptr) {
                        cout << "Student Found: " << foundStudent->getName() << "\n";
                        foundStudent->getCourseNames(); // Display what courses they currently have

                        vector<string> activeCourses = foundStudent->getCoursesEnrolledList();
                        if (activeCourses.empty()) {
                            cout << "This student is not enrolled in any extra courses.\n";
                            break;
                        }

                        cout << "Enter the exact name of the course you want to drop: ";
                        string courseToDrop;

                        getline(cin, courseToDrop); // Allows spaces in course names like "Data Science"

                        if (foundStudent->removeCourse(courseToDrop)) {
                            cout << "Successfully dropped '" << courseToDrop << "' from student's profile.\n";

                            // 4. CRITICAL: Instantly save changes to disk so they persist
                            if (isDomestic) {
                                saveStudentsToFile("domestic_students.txt", dmtcStudents);
                            }
                            else {
                                saveStudentsToFile("international_students.txt", intlStudents);
                            }
                        }
                        else {
                            cout << "Error: The student is not registered in a course with that exact name.\n";
                        }
                    }
                    else {
                        cout << "Student ID not found in database.\n";
                    }
                    break;


                }

                case 6: { // REMOVE A STUDENT FROM RECORD
                    cout << "[6] Selected - Remove Student From Course\n";
                    cout << "------------------------------------\n";
                    cout << "---   Remove Student from Record ---\n";
                    cout << "Enter the ID number of the student you want to remove: ";
                    int removeId;
                    cin >> removeId;

                    char confirmChoice;
                    bool isDomestic = false;
                    Student* studentToDelete = nullptr;

                    // 1. Search International Students
                    auto itIntl = find_if(intlStudents.begin(), intlStudents.end(),
                        [removeId](const Student& s) { return s.getidNumber() == removeId; });

                    // 2. Search Domestic Students if not found in International
                    auto itDmtc = find_if(dmtcStudents.begin(), dmtcStudents.end(),
                        [removeId](const Student& s) { return s.getidNumber() == removeId; });

                    // Determine where the student lives
                    if (itIntl != intlStudents.end()) {
                        studentToDelete = &(*itIntl);
                        isDomestic = false;
                    }
                    else if (itDmtc != dmtcStudents.end()) {
                        studentToDelete = &(*itDmtc);
                        isDomestic = true;
                    }

                    // 3. Handle deletion confirmation if student exists
                    if (studentToDelete != nullptr) {
                        cout << "\nFound Student: " << studentToDelete->getName() << " (ID: " << removeId << ")\n";
                        cout << "WARNING: This will permanently delete the student from the database.\n";
                        cout << "Are you sure you want to remove this student? [Y/N]: ";
                        cin >> confirmChoice;

                        // Accept lowercase 'y' or uppercase 'Y'
                        if (confirmChoice == 'Y' || confirmChoice == 'y') {
                            if (isDomestic) {
                                dmtcStudents.erase(itDmtc);
                                saveStudentsToFile("domestic_students.txt", dmtcStudents); // CRITICAL: Save file updates
                            }
                            else {
                                intlStudents.erase(itIntl);
                                saveStudentsToFile("international_students.txt", intlStudents); // CRITICAL: Save file updates
                            }
                            cout << "\nStudent removed successfully from record and database files.\n";
                        }
                        else {
                            cout << "\nDeletion canceled.\n";
                        }
                    }
                    else {
                        cout << "\nError: Student ID " << removeId << " not found in database.\n";
                    }

                    break;
                }

                case 0: { //LOGOUT
                    cout << "[7] Selected\n";
                    adminLoggedIn = false;
                    system("cls");
                    break;



                }


                      //switch end
                }

                //While adminLoggedIn end
            }

            //While run==2 end
        }

              //option end
        }
        //while end
    }

    //main end
}



