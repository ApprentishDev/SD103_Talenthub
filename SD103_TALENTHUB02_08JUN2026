// Reusable function to capture password input securely
string getMaskedPassword() {
    string password = "";
    char character;

    while (true) {
        character = _getch(); // Read a character without printing it to the screen

        // Check for Enter key (carriage return '\r' or newline '\n')
        if (character == '\r' || character == '\n') {
            break;
        }
        // Check for Backspace key
        else if (character == '\b') {
            if (!password.empty()) {
                password.pop_back();
                // Erase the last asterisk from the console view
                cout << "\b \b";
            }
        }
        // Handle normal visible characters
        else if (isprint(character)) {
            password.push_back(character);
            cout << '*';
        }
    }
    cout << endl; // Move to the next line once Enter is pressed
    return password;
}


//--- FILE HANDLING FUNCTIONS ---

void saveStudentsToFile(const string& fileName, const vector<Student>& studentVector) {
    ofstream outFile(fileName);
    if (!outFile) {
        cout << "Error opening file " << fileName << " for writing.\n";
        return;
    }

    for (const auto& student : studentVector) {
        // Replace spaces inside strings with a safe delimiter (e.g., pipe '|' character)
        outFile << student.getfirstName() << "|"
            << student.getlastName() << "|"
            << student.getidNumber() << "|"
            << student.getAge() << "|"
            << student.getAddress() << "|"
            << student.getEmail() << "|"
            << student.getPhoneNumber() << "|"
            << student.getCourseCount() << "|"
            << student.getUserName() << "|"
            << student.getPassword() << "|";

        // Save up to 3 course string placeholders 
        outFile << student.getCourse1() << "|"
            << student.getCourse2() << "|"
            << student.getCourse3() << "|";

        // Dynamically track and save extra courses enrolled via user interface
        vector<string> extraCourses = student.getCoursesEnrolledList();
        outFile << extraCourses.size();
        for (const auto& extraCourse : extraCourses) {
            outFile << "|" << extraCourse;
        }
        outFile << "\n";
    }
    outFile.close();
}

void loadStudentsFromFile(const string& fileName, vector<Student>& studentVector, map<string, string>& userDatas) {
    ifstream inFile(fileName);
    if (!inFile) {
        // File might not exist on the first run, which is completely fine
        return;
    }

    string fileLine;
    while (getline(inFile, fileLine)) {
        if (fileLine.empty()) continue;

        stringstream sStream(fileLine);
        string fName, lName, addr, mail, uName, pass, c1, c2, c3, token;
        int idNum = 0, age = 0, phoneNum = 0, cCount = 0, extraCount = 0;

        try {
            getline(sStream, fName, '|');
            getline(sStream, lName, '|');

            if (!getline(sStream, token, '|') || token.empty()) continue;
            idNum = stoi(token);

            if (!getline(sStream, token, '|') || token.empty()) continue;
            age = stoi(token);

            getline(sStream, addr, '|');
            getline(sStream, mail, '|');

            if (!getline(sStream, token, '|') || token.empty()) continue;
            phoneNum = stoi(token);

            if (!getline(sStream, token, '|') || token.empty()) continue;
            cCount = stoi(token);

            getline(sStream, uName, '|');
            getline(sStream, pass, '|');
            getline(sStream, c1, '|');
            getline(sStream, c2, '|');
            getline(sStream, c3, '|');

            if (!getline(sStream, token, '|') || token.empty()) continue;
            extraCount = stoi(token);

            Student loadedStudent(fName, lName, idNum, age, addr, mail, phoneNum, cCount, uName, pass, c1, c2, c3);

            for (int i = 0; i < extraCount; i++) {
                string extraCourseName;
                if (getline(sStream, extraCourseName, '|')) {
                    if (extraCourseName != c1 && extraCourseName != c2 && extraCourseName != c3) {
                        loadedStudent.enrollCourse(extraCourseName);
                    }
                }
            }

            studentVector.push_back(loadedStudent);
            userDatas[uName] = pass;
        }
        catch (const exception& e) {
            // Skips malformed file lines cleanly without breaking execution flow
            continue;
        }
    }
    inFile.close();
}

bool isValidPassword(const string& password)
{
    bool hasNumber = false;
    bool hasSymbol = false;

    if (password.length() < 8)
    {
        return false;
    }

    for (char ch : password)
    {
        if (isdigit(static_cast<unsigned char>(ch)))
        {
            hasNumber = true;
        }
        else if (!isalnum(static_cast<unsigned char>(ch)))
        {
            hasSymbol = true;
        }
    }

    return hasNumber && hasSymbol;
}


